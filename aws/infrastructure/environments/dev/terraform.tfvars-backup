#########################################################
# SECURITY GRP RULES
#########################################################
security_group_rules = {

  #####################################################
  # BASTION SECURITY GROUP
  #####################################################

  bastion = {

    ingress = {

      ##########################################
      # Home Network to Bastion Server (SSH)
      ##########################################
      ssh = {

        description = "SSH from Home"

        protocol = "tcp"
        from_port = 22
        to_port = 22

        cidr_blocks = [
          "103.49.53.216/32"
        ]

      }

    }

    egress = {

      ##########################################
      # Bastion Server to EKS Control Plane API
      ##########################################
      https = {

        description = "HTTPS Outbound"

        protocol = "tcp"

        from_port = 443

        to_port = 443

        cidr_blocks = [
          "0.0.0.0/0"
        ]

      }

      ##########################################
      # Bastion Server to Jenkins Private Server
      ##########################################
      ssh_jenkins = {

        description = "SSH to Jenkins"

        protocol = "tcp"

        from_port = 22

        to_port = 22

        source_security_group = "jenkins"

      }

    }

  }

  #####################################################
  # APPLICATION LOAD BALANCER
  #####################################################

  alb = {

    ingress = {

      ##########################################
      # Internet Users to ALB (HTTP)
      ##########################################
      http = {

        description = "HTTP"

        protocol = "tcp"

        from_port = 80

        to_port = 80

        cidr_blocks = [
          "0.0.0.0/0"
        ]

      }

      ##########################################
      # Internet Users to ALB (HTTPS)
      ##########################################
      https = {

        description = "HTTPS"

        protocol = "tcp"

        from_port = 443

        to_port = 443

        cidr_blocks = [
          "0.0.0.0/0"
        ]

      }

    }

    egress = {

      ##########################################
      # ALB to EKS Worker NodePort Services
      ##########################################
      eks_nodes = {

        description = "Traffic to Worker Nodes"

        protocol = "tcp"

        from_port = 30000

        to_port = 32767

        source_security_group = "eks-nodes"

      }

      ##########################################
      # ALB to Jenkins Private Server
      ##########################################
      jenkins = {

        description = "Forward traffic to Jenkins"

        protocol = "tcp"

        from_port = 8080

        to_port = 8080

        source_security_group = "jenkins"

      }

    }

  }

  #####################################################
  # JENKINS SECURITY GROUP
  #####################################################

  jenkins = {

    ingress = {

      ##########################################
      # ALB to Jenkins Web Application
      ##########################################
      alb = {

        description = "HTTP from ALB"

        protocol = "tcp"

        from_port = 8080

        to_port = 8080

        source_security_group = "alb"

      }

      ##########################################
      # Bastion Server to Jenkins SSH
      ##########################################
      ssh = {

        description = "SSH from Bastion"

        protocol = "tcp"

        from_port = 22

        to_port = 22

        source_security_group = "bastion"

      }

    }

    egress = {

      ##########################################
      # Jenkins Server to Internet Services
      # GitHub, Docker Hub, S3, CloudWatch,
      # Jenkins Plugins, Slack, Teams, etc.
      ##########################################
      https = {

        description = "HTTPS Outbound"

        protocol = "tcp"

        from_port = 443

        to_port = 443

        cidr_blocks = [
          "0.0.0.0/0"
        ]

      }

    }

  }

  #####################################################
  # EKS CONTROL PLANE
  #####################################################

  eks = {

    ingress = {

      ##########################################
      # Bastion Server to EKS Control Plane API
      ##########################################
      api_from_bastion = {

        description = "Bastion to EKS API"

        protocol = "tcp"

        from_port = 443

        to_port = 443

        source_security_group = "bastion"

      }

    }

    egress = {

      ##########################################
      # EKS Control Plane to Internet Services
      ##########################################
      https = {

        description = "HTTPS Outbound"

        protocol = "tcp"

        from_port = 443

        to_port = 443

        cidr_blocks = [
          "0.0.0.0/0"
        ]

      }

    }

  }

}


